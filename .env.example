# Supabase (클라이언트 공개 가능 — Google 로그인용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (서버 전용 — 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API (서버 전용)
GEMINI_API_KEY=

# Gmail 발송 (Gmail SMTP, 서버 전용)
# GMAIL_USER: 발신용 Gmail 주소
# GMAIL_APP_PASSWORD: 구글 계정 2단계 인증 후 발급받은 앱 비밀번호(일반 로그인 비밀번호 아님)
GMAIL_USER=
GMAIL_APP_PASSWORD=
